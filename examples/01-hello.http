## ============================================================================
## Hello World — simplest possible pawsh flow
## ============================================================================
## A single GET request with a few assertions on the response. Run with:
##   pawsh run examples/01-hello.http
## ============================================================================

### 1.1 Fetch a public post
GET {{jsonplaceholder}}/posts/1
Accept: application/json

> {%
    client.test("status is 200", function() {
        client.assert(response.status === 200, "wrong status: " + response.status);
    });
    client.test("body has id=1", function() {
        client.assert(response.body.id === 1, "expected id=1");
    });
    client.test("body has a title", function() {
        client.assert(typeof response.body.title === "string", "title missing");
        client.assert(response.body.title.length > 0, "title was empty");
    });
%}
