{
  "name": "pawsh",
  "version": "0.1.0",
  "description": "Terminal-native runner for JetBrains Rider / IntelliJ .http flow files, with an interactive Ink TUI and a plain-text reporter for CI.",
  "keywords": [
    "http",
    "rest",
    "rider",
    "intellij",
    "jetbrains",
    "http-client",
    "cli",
    "tui",
    "ink",
    "api",
    "testing"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pawsh": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "clean": "rm -rf dist",
    "dev": "bun src/cli.ts",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepublishOnly": "bun run clean && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^7.0.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8"
  }
}
